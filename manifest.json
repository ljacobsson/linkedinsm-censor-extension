{
  "manifest_version": 3,
  "name": "LinkedInism Censor",
  "version": "1.7.1",
  "description": "Spot and censor corporate LinkedIn clichés in your feed.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.linkedin.com/*"],
  "action": {
    "default_title": "LinkedInism Censor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["phrases.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
